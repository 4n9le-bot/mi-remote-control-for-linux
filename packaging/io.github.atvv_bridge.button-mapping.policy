<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC
  "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
  "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<policyconfig>
  <vendor>ATVV Voice Bridge</vendor>
  <vendor_url>https://github.com/4n9le-bot/mi-remote-control-for-linux</vendor_url>
  <action id="io.github.atvv_bridge.button-mapping.modify">
    <description>Modify system-wide ATVV Remote button mappings</description>
    <message>Authentication is required to modify ATVV Remote button mappings</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>auth_admin</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/libexec/atvv-bridge/atvv-button-mapping-helper</annotate>
  </action>
</policyconfig>
